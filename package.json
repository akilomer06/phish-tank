{
  "name": "phish-tank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "postinstall": "npm run build -w shared",
    "predev": "npm run build -w shared",
    "pretypecheck": "npm run build -w shared",
    "dev": "concurrently -k -n shared,server,client -c green,magenta,cyan \"npm run dev -w shared\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "start": "node server/dist/index.js --production",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
